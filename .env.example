# Образец переменных окружения (реальные значения — в .env, .env.dev,
# .env.development, .env.production; они в .gitignore).
# Значений по умолчанию в коде нет: без переменной фронт не подставит «запасной» адрес.
#
# Какой файл читается:
#   pnpm dev   → .env + .env.dev          (режим dev, удобно для локального бэка)
#   pnpm start → .env + .env.development
#   pnpm build → .env + .env.production   (в Docker — build-аргументы, см. Dockerfile)

# Бэкенд API: origin без слэша на конце (локально бэк слушает 8090).
VITE_API_URL=http://localhost:8090

# Оператор платформы — реквизиты в подвале главной, на 404 и в политике
# конфиденциальности платформы (/privacy). Пустое значение — строка не выводится.
# Название организации или ФИО ИП, как в выписке ЕГРЮЛ/ЕГРИП.
VITE_PLATFORM_OPERATOR_NAME=ИП Иванов Иван Иванович
# ИНН: 10 цифр у организации, 12 у ИП.
VITE_PLATFORM_OPERATOR_INN=000000000000
# ОГРН (13 цифр) или ОГРНИП (15 цифр).
VITE_PLATFORM_OPERATOR_OGRN=000000000000000
# Почта для связи с платформой (мерчанты, вопросы по персональным данным).
VITE_PLATFORM_CONTACT_EMAIL=hello@example.com
